# MythoMax API — Caddy config (Hetzner)
# Auto HTTPS + Bearer token authentication
# Only the XinMate Azure app should access this

mythomax.parallaxstar.com {
    # Health check — no auth (for uptime monitors)
    handle /health {
        reverse_proxy mythomax:8000
    }

    # All other routes require API key
    handle {
        @no_auth {
            not header Authorization "Bearer {env.MYTHOMAX_API_KEY}"
        }
        respond @no_auth "Unauthorized" 401

        reverse_proxy mythomax:8000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }

    log {
        output file /data/access.log {
            roll_size 20MiB
            roll_keep 3
        }
    }
}
